{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Fuelwise",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*"
        }
      }
    }
  ]
}
